{
  "name": "clipshelf",
  "version": "0.5.5",
  "private": true,
  "description": "Local-first Windows clipboard shelf",
  "repository": {
    "type": "git",
    "url": "https://github.com/wdlami/ClipShelf.git"
  },
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "smoke": "electron . --smoke",
    "build:native": "node scripts/build-native.cjs",
    "pack": "npm run build:native && electron-packager . ClipShelf --platform=win32 --arch=x64 --out=dist/v0.5.5 --overwrite --extra-resource=build/ClipShelf.Native.exe --extra-resource=src/native.ps1 --ignore=^/build --ignore=^/scripts --ignore=^/dist --ignore=^/reference --ignore=^/test --ignore=^/docs --ignore=^/artifacts --ignore=^/.smoke-data --ignore=paste-reference-evidence.json",
    "perf": "electron . --performance",
    "verify:clipboard": "electron . --clipboard-integration",
    "verify:startup": "electron . --startup-integration",
    "verify:paste": "electron . --paste-integration"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "42.11.15"
  }
}
